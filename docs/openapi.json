      },
      "DecisionRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "title": "Decision",
            "description": "approve or reject"
          },
          "remarks": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Remarks"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "remarks"
        ],
        "title": "DecisionRequest",
        "description": "POST /applications/{id}/decision body."
      },
      "DecisionResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "title": "DecisionResponse",
        "description": "POST /applications/{id}/decision response."
      },
      "DepartmentResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "service_type": {
            "type": "string",
            "title": "Service Type"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "service_type"
        ],
        "title": "DepartmentResponse",
        "description": "One department entry."
      },
      "DocumentSummary": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "doc_type": {
            "type": "string",
            "title": "Doc Type"
          },
          "original_filename": {
            "type": "string",
            "title": "Original Filename"
          },
          "validation_status": {
            "type": "string",
            "title": "Validation Status"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Uploaded At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "doc_type",
          "original_filename",
          "validation_status",
          "uploaded_at"
        ],
