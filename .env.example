# ── App ──────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/civicflow

# ── Auth ─────────────────────────────────────────────────────
# REQUIRED — app will not start without JWT_SECRET_KEY
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI / LLM ─────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── OCR ──────────────────────────────────────────────────────
OCR_ENGINE=tesseract

# ── Storage / MinIO ──────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=civicflow
MINIO_SECURE=false
MAX_UPLOAD_MB=5

# ── n8n Workflows ────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
